#!/bin/sh
set -eu

SOURCE=$0
while [ -h "$SOURCE" ]; do
  LINK_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
  TARGET=$(readlink "$SOURCE")
  case "$TARGET" in
    /*) SOURCE=$TARGET ;;
    *) SOURCE=$LINK_DIR/$TARGET ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
ROOT=$(dirname "$SCRIPT_DIR")
CLI=$ROOT/engine/apps/openaqua-harness/dist/cli.mjs

if [ ! -f "$CLI" ]; then
  echo "openaqua: engine not built ($CLI missing)" >&2
  echo "run: cd $ROOT && npm run setup" >&2
  exit 1
fi

NODE_BIN=$(command -v node || true)
if [ -z "$NODE_BIN" ]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node "$HOME/.local/bin/node"; do
    if [ -x "$candidate" ]; then
      NODE_BIN=$candidate
      break
    fi
  done
fi
if [ -z "$NODE_BIN" ]; then
  echo "openaqua: node not found (requires Node.js >= 24.15.0)" >&2
  exit 1
fi

if ! "$NODE_BIN" -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  process.exit(major > 24 || (major === 24 && minor >= 15) ? 0 : 1);
'; then
  VERSION=$($NODE_BIN --version 2>/dev/null || echo unknown)
  echo "openaqua: Node.js >= 24.15.0 is required (found $VERSION at $NODE_BIN)" >&2
  exit 1
fi

exec "$NODE_BIN" "$CLI" "$@"
